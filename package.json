{
  "name": "guido",
  "author": "Gui Ruggiero",
  "homepage": "https://guiruggiero.com/",
  "version": "0.1",
  "type": "module",
  "main": "app.js",
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@langfuse/client": "^6.1.1",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.1",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@sentry/node": "^11.12.0",
    "@vonage/jwt": "^1.18.1",
    "@vonage/messages": "^1.28.1",
    "@vonage/server-sdk": "^3.31.1",
    "axios": "^1.21.1",
    "axios-retry": "^4.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.2.0",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0",
    "sanitize-html": "^2.17.7"
  },
  "globalDependencies": {
    "@infisical/cli": ""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "terser": "^5.51.2"
  },
  "overrides": {
    "minimatch": ">=11.0.1",
    "glob": ">=14.0.2"
  },
  "nodemonConfig": {
    "ext": "js",
    "ignore": [
      "**/.github/**",
      "**/references/**",
      "**/eslint.config.js"
    ],
    "delay": 600000
  },
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "dev": "APP_ENV=dev infisical run -- nodemon --import ./src/startup.js app.js",
    "tunnel": "ngrok start guido",
    "build": "esbuild app.js --bundle --format=esm --platform=node --packages=external --minify --sourcemap --outfile=dist/app.js",
    "minify": "terser ./src/startup.js --module --compress --mangle --source-map \"filename='./src/startup.js.map',url='startup.js.map'\" -o ./src/startup.js",
    "start": "infisical run -- node --import ./src/startup.js dist/app.js",
    "monitor": "htop --sort-key=PERCENT_MEM --tree --user",
    "prompt-pull": "infisical run -- node scripts/promptSync.js pull",
    "prompt-push": "infisical run -- node scripts/promptSync.js push"
  }
}
